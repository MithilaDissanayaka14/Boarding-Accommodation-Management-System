# Server Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# For local MongoDB: mongodb://127.0.0.1:27017/boarding_db
# For Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/boarding_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/boarding_db

# Security & JWT Tokens
JWT_SECRET=super_secret_access_jwt_key_bams_development_token_2026_xyz
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_bams_development_refresh_2026_abc
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=bams_cookie_signing_secret_phrase_here

# Cloudinary Media Storage (Optional: fallback to local /uploads/ if not provided)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
